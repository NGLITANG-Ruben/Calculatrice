<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculatrice.MainPage"
             Title="Calculatrice"
             BackgroundColor="White">

    <ContentPage.Resources>
        <!-- Bleu nuit utilisé pour le survol, le clic et le résultat -->
        <Color x:Key="BleuNuit">#1A237E</Color>

        <!-- Style appliqué automatiquement à tous les boutons -->
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="Black" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Black" />
                                <Setter Property="Scale" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <!-- Survol de la souris (Windows) -->
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource BleuNuit}" />
                            </VisualState.Setters>
                        </VisualState>
                        <!-- Clic ou appui du doigt -->
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource BleuNuit}" />
                                <Setter Property="Scale" Value="0.95" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="2*,5*" Padding="16">

        <!-- Zone d'affichage : opération en cours + résultat -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="End" Padding="10,0,10,12" Spacing="4">
            <Label x:Name="ExpressionLabel"
                   Text=""
                   FontSize="22"
                   TextColor="Gray"
                   HorizontalTextAlignment="End"
                   LineBreakMode="HeadTruncation"
                   MaxLines="1" />
            <Label x:Name="ResultLabel"
                   Text="0"
                   FontSize="56"
                   FontAttributes="Bold"
                   TextColor="{StaticResource BleuNuit}"
                   HorizontalTextAlignment="End"
                   LineBreakMode="HeadTruncation"
                   MaxLines="1" />
        </VerticalStackLayout>

        <!-- Clavier : 5 lignes x 4 colonnes -->
        <Grid Grid.Row="1"
              RowDefinitions="*,*,*,*,*"
              ColumnDefinitions="*,*,*,*">

            <!-- Ligne 1 -->
            <Button Grid.Row="0" Grid.Column="0" Text="C"  Clicked="OnClearClicked" />
            <Button Grid.Row="0" Grid.Column="1" Text="±"  Clicked="OnSignClicked" />
            <Button Grid.Row="0" Grid.Column="2" Text="%"  Clicked="OnPercentClicked" />
            <Button Grid.Row="0" Grid.Column="3" Text="÷"  Clicked="OnOperatorClicked" />

            <!-- Ligne 2 -->
            <Button Grid.Row="1" Grid.Column="0" Text="7"  Clicked="OnDigitClicked" />
            <Button Grid.Row="1" Grid.Column="1" Text="8"  Clicked="OnDigitClicked" />
            <Button Grid.Row="1" Grid.Column="2" Text="9"  Clicked="OnDigitClicked" />
            <Button Grid.Row="1" Grid.Column="3" Text="×"  Clicked="OnOperatorClicked" />

            <!-- Ligne 3 -->
            <Button Grid.Row="2" Grid.Column="0" Text="4"  Clicked="OnDigitClicked" />
            <Button Grid.Row="2" Grid.Column="1" Text="5"  Clicked="OnDigitClicked" />
            <Button Grid.Row="2" Grid.Column="2" Text="6"  Clicked="OnDigitClicked" />
            <Button Grid.Row="2" Grid.Column="3" Text="−"  Clicked="OnOperatorClicked" />

            <!-- Ligne 4 -->
            <Button Grid.Row="3" Grid.Column="0" Text="1"  Clicked="OnDigitClicked" />
            <Button Grid.Row="3" Grid.Column="1" Text="2"  Clicked="OnDigitClicked" />
            <Button Grid.Row="3" Grid.Column="2" Text="3"  Clicked="OnDigitClicked" />
            <Button Grid.Row="3" Grid.Column="3" Text="+"  Clicked="OnOperatorClicked" />

            <!-- Ligne 5 : le 0 occupe deux colonnes -->
            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="0" Clicked="OnDigitClicked" />
            <Button Grid.Row="4" Grid.Column="2" Text="."  Clicked="OnDecimalClicked" />
            <Button Grid.Row="4" Grid.Column="3" Text="="  Clicked="OnEqualsClicked" />
        </Grid>
    </Grid>
</ContentPage>
